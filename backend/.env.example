# Backend local env (copy to .env for local testing; in Lambda use real env vars)
AWS_REGION=us-east-1
TICKETS_TABLE=tickets-dev
COMMENTS_TABLE=ticket-comments-dev
ATTACHMENTS_BUCKET=ticket-attachments-dev-ACCOUNTID
# Presigned URL expiry in seconds
PRESIGNED_URL_EXPIRES_IN=300
# Comma-separated allowed attachment MIME types (keep small for Free Tier demo)
ALLOWED_MIME_TYPES=image/png,image/jpeg,application/pdf,text/plain
MAX_ATTACHMENT_BYTES=5242880
